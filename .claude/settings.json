{
 "$schema": "https://json.schemastore.org/claude-code-settings.json",
 "permissions": {
  "allow": [
   "Bash(npm run check:log-uuids)",
   "Bash(npm run check:pinned-deps)",
   "Bash(npm run lint)",
   "Bash(npm run lint:fix)",
   "Bash(npm run typecheck)",
   "Bash(npm test)",
   "Bash(npx vitest run:*)"
  ],
  "deny": [
   "Edit(**/.env)",
   "Read(**/.env)"
  ]
 }
}
